<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system trust store only. The only network traffic this app ever makes
     is the POS APK download (and the launcher's own download is done by the system's
     ManagedProvisioning, not by us). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
